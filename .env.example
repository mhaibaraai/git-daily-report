# Gitee：https://gitee.com/profile/personal_access_tokens 生成，勾选 enterprises 权限
GITEE_ACCESS_TOKEN=
# 企业标识，即企业主页地址 gitee.com/enterprises/<这一段>
GITEE_ENTERPRISE=
# 你的 Gitee 登录名，用于只拉本人名下的工作项
GITEE_ASSIGNEE=

# GitLab：<实例地址>/-/user_settings/personal_access_tokens 生成，scope 勾 read_api
# 常见是内网实例，脱离内网时该源自动跳过
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TOKEN=

# AI：任意 OpenAI 兼容接口，换供应商只改这三项
# 例：阿里云百炼 https://dashscope.aliyuncs.com/compatible-mode/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=qwen-plus
