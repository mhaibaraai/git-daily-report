# EOM：只能在企微内登录，取法见 README「获取 EOM token」
# EOM_BASE_URL 是 EOM 后端接口地址（企微网页检查器「网络」里 core/busi 请求的前缀）
EOM_BASE_URL=
EOM_TOKEN=

# GitLab：<实例地址>/-/user_settings/personal_access_tokens 生成，scope 勾 read_api
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TOKEN=

# AI：任意 OpenAI 兼容接口，换供应商只改这三项
# 例：阿里云百炼 https://dashscope.aliyuncs.com/compatible-mode/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=qwen3.8-flash
